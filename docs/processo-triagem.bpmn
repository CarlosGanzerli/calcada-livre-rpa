<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definicoes" targetNamespace="https://github.com/CarlosGanzerli/calcada-livre-rpa" exporter="Calçada Livre" exporterVersion="2.0">
<bpmn:process id="TriagemOcorrencias" name="Triagem de ocorrências da Calçada Livre (RPA)" isExecutable="false">
<bpmn:startEvent id="inicio" name="A cada 15 minutos"><bpmn:outgoing>f1</bpmn:outgoing><bpmn:timerEventDefinition id="TimerDef"><bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/PT15M</bpmn:timeCycle></bpmn:timerEventDefinition></bpmn:startEvent>
<bpmn:serviceTask id="lote" name="Importar lotes CSV&#10;(pasta entrada/)"><bpmn:incoming>f1</bpmn:incoming><bpmn:outgoing>f2</bpmn:outgoing></bpmn:serviceTask>
<bpmn:serviceTask id="ler" name="Ler ocorrências&#10;novas (API do MVP)"><bpmn:incoming>f2</bpmn:incoming><bpmn:outgoing>f3</bpmn:outgoing></bpmn:serviceTask>
<bpmn:exclusiveGateway id="gwApi" name="API respondeu?&#10;(4 tentativas)"><bpmn:incoming>f3</bpmn:incoming><bpmn:outgoing>f4</bpmn:outgoing><bpmn:outgoing>f5</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:endEvent id="fimApi" name="Registra ERRO&#10;e encerra sem&#10;alterar nada"><bpmn:incoming>f4</bpmn:incoming><bpmn:errorEventDefinition id="ErroDef"/></bpmn:endEvent>
<bpmn:serviceTask id="clima" name="Consultar previsão&#10;de chuva"><bpmn:incoming>f5</bpmn:incoming><bpmn:outgoing>f6</bpmn:outgoing></bpmn:serviceTask>
<bpmn:subProcess id="sub" name="Para cada ocorrência nova"><bpmn:incoming>f6</bpmn:incoming><bpmn:outgoing>f7</bpmn:outgoing><bpmn:multiInstanceLoopCharacteristics isSequential="true"/><bpmn:startEvent id="sInicio"><bpmn:outgoing>s1</bpmn:outgoing></bpmn:startEvent>
<bpmn:exclusiveGateway id="gwVal" name="Dados válidos?"><bpmn:incoming>s1</bpmn:incoming><bpmn:outgoing>s2</bpmn:outgoing><bpmn:outgoing>s4</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:exclusiveGateway id="gwDup" name="Já relatada?&#10;(mesmo tipo, até&#10;20 m, em 7 dias)"><bpmn:incoming>s4</bpmn:incoming><bpmn:outgoing>s5</bpmn:outgoing><bpmn:outgoing>s7</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:serviceTask id="dup" name="Marcar como&#10;duplicada"><bpmn:incoming>s5</bpmn:incoming><bpmn:outgoing>s6</bpmn:outgoing></bpmn:serviceTask>
<bpmn:endEvent id="fimDup" name="Duplicada"><bpmn:incoming>s6</bpmn:incoming></bpmn:endEvent>
<bpmn:businessRuleTask id="prio" name="Decidir&#10;prioridade"><bpmn:incoming>s7</bpmn:incoming><bpmn:outgoing>s8</bpmn:outgoing></bpmn:businessRuleTask>
<bpmn:serviceTask id="meta" name="Subprefeitura&#10;e protocolo"><bpmn:incoming>s8</bpmn:incoming><bpmn:outgoing>s9</bpmn:outgoing></bpmn:serviceTask>
<bpmn:serviceTask id="lgpd" name="Remover dado&#10;pessoal (LGPD)"><bpmn:incoming>s9</bpmn:incoming><bpmn:outgoing>s10</bpmn:outgoing></bpmn:serviceTask>
<bpmn:serviceTask id="grava" name="Gravar no MVP&#10;(API com chave)"><bpmn:incoming>s10</bpmn:incoming><bpmn:outgoing>s11</bpmn:outgoing></bpmn:serviceTask>
<bpmn:endEvent id="sFim" name="Encaminhada"><bpmn:incoming>s11</bpmn:incoming></bpmn:endEvent>
<bpmn:serviceTask id="quar" name="Marcar&#10;quarentena&#10;com o motivo"><bpmn:incoming>s2</bpmn:incoming><bpmn:outgoing>s3</bpmn:outgoing></bpmn:serviceTask>
<bpmn:endEvent id="fimQuar" name="Em quarentena"><bpmn:incoming>s3</bpmn:incoming></bpmn:endEvent>
<bpmn:sequenceFlow id="s1" sourceRef="sInicio" targetRef="gwVal"/>
<bpmn:sequenceFlow id="s2" name="Não" sourceRef="gwVal" targetRef="quar"/>
<bpmn:sequenceFlow id="s3" sourceRef="quar" targetRef="fimQuar"/>
<bpmn:sequenceFlow id="s4" name="Sim" sourceRef="gwVal" targetRef="gwDup"/>
<bpmn:sequenceFlow id="s5" name="Sim" sourceRef="gwDup" targetRef="dup"/>
<bpmn:sequenceFlow id="s6" sourceRef="dup" targetRef="fimDup"/>
<bpmn:sequenceFlow id="s7" name="Não" sourceRef="gwDup" targetRef="prio"/>
<bpmn:sequenceFlow id="s8" sourceRef="prio" targetRef="meta"/>
<bpmn:sequenceFlow id="s9" sourceRef="meta" targetRef="lgpd"/>
<bpmn:sequenceFlow id="s10" sourceRef="lgpd" targetRef="grava"/>
<bpmn:sequenceFlow id="s11" sourceRef="grava" targetRef="sFim"/>
<bpmn:textAnnotation id="nota4"><bpmn:text>Alta: até 150 m de hospital, escola
ou ponto de ônibus. Chuva prevista
(60% ou mais): sobe um nível</bpmn:text></bpmn:textAnnotation>
<bpmn:association id="as_nota4" sourceRef="prio" targetRef="nota4"/>
</bpmn:subProcess>
<bpmn:serviceTask id="pacote" name="Gerar CSV e e-mail&#10;por subprefeitura"><bpmn:incoming>f7</bpmn:incoming><bpmn:outgoing>f8</bpmn:outgoing></bpmn:serviceTask>
<bpmn:exclusiveGateway id="gwAlta" name="Há ocorrência de&#10;prioridade alta?"><bpmn:incoming>f8</bpmn:incoming><bpmn:outgoing>f9</bpmn:outgoing><bpmn:outgoing>f10</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:sendTask id="alerta" name="Enviar alerta&#10;(webhook ou log)"><bpmn:incoming>f9</bpmn:incoming><bpmn:outgoing>f11</bpmn:outgoing></bpmn:sendTask>
<bpmn:exclusiveGateway id="gwJunta"><bpmn:incoming>f10</bpmn:incoming><bpmn:incoming>f11</bpmn:incoming><bpmn:outgoing>f12</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:serviceTask id="resumo" name="Registrar resumo no&#10;log de auditoria"><bpmn:incoming>f12</bpmn:incoming><bpmn:outgoing>f13</bpmn:outgoing></bpmn:serviceTask>
<bpmn:endEvent id="fim" name="Triagem concluída"><bpmn:incoming>f13</bpmn:incoming></bpmn:endEvent>
<bpmn:sequenceFlow id="f1" sourceRef="inicio" targetRef="lote"/>
<bpmn:sequenceFlow id="f2" sourceRef="lote" targetRef="ler"/>
<bpmn:sequenceFlow id="f3" sourceRef="ler" targetRef="gwApi"/>
<bpmn:sequenceFlow id="f4" name="Não" sourceRef="gwApi" targetRef="fimApi"/>
<bpmn:sequenceFlow id="f5" name="Sim" sourceRef="gwApi" targetRef="clima"/>
<bpmn:sequenceFlow id="f6" sourceRef="clima" targetRef="sub"/>
<bpmn:sequenceFlow id="f7" sourceRef="sub" targetRef="pacote"/>
<bpmn:sequenceFlow id="f8" sourceRef="pacote" targetRef="gwAlta"/>
<bpmn:sequenceFlow id="f9" name="Sim" sourceRef="gwAlta" targetRef="alerta"/>
<bpmn:sequenceFlow id="f10" name="Não" sourceRef="gwAlta" targetRef="gwJunta"/>
<bpmn:sequenceFlow id="f11" sourceRef="alerta" targetRef="gwJunta"/>
<bpmn:sequenceFlow id="f12" sourceRef="gwJunta" targetRef="resumo"/>
<bpmn:sequenceFlow id="f13" sourceRef="resumo" targetRef="fim"/>
<bpmn:textAnnotation id="nota1"><bpmn:text>Arquivo vazio, ilegível ou sem as
colunas vai para rejeitados/ e o
motivo vai para o log</bpmn:text></bpmn:textAnnotation>
<bpmn:association id="as_nota1" sourceRef="lote" targetRef="nota1"/>
<bpmn:textAnnotation id="nota2"><bpmn:text>Se a previsão falhar, segue
sem a regra de chuva e
registra AVISO</bpmn:text></bpmn:textAnnotation>
<bpmn:association id="as_nota2" sourceRef="clima" targetRef="nota2"/>
<bpmn:textAnnotation id="nota3"><bpmn:text>Envio SIMULADO: nada
sai para a Prefeitura</bpmn:text></bpmn:textAnnotation>
<bpmn:association id="as_nota3" sourceRef="pacote" targetRef="nota3"/>
</bpmn:process>
